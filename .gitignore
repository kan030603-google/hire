# Operating-system and editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Office lock files and generic temporary files
~$*
*.tmp
*.temp

# Reproducible rendering, review, and backup artifacts
/tmp/pdfs/
/tmp/reviews/
/tmp/**/renders*/
/tmp/**/backups*/

# Superseded resume layout variants (the canonical resume files stay tracked)
/简历_优化排版*.docx

# Nowcoder collector runtime and smoke-test artifacts
/nowcoder_agent_mvp/data/
/nowcoder_agent_mvp/output/*smoke-test*.md
